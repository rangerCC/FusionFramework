# Copy to .env (for docker compose) or export these before `make run`.
# NEVER commit real secrets.

# Runtime
APP_ENV=dev                 # dev | prod
PORT=8080

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/socialstory?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (CHANGE in production — use a long random secret)
JWT_SECRET=dev-insecure-change-me
ACCESS_TTL_SEC=7200
REFRESH_TTL_SEC=2592000

# SMS — dev mode logs a fixed code instead of calling Aliyun
SMS_DEV_MODE=true
SMS_DEV_CODE=1234
ALIYUN_SMS_KEY=
ALIYUN_SMS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# OSS (avatar direct upload)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET=
OSS_PUBLIC_HOST=

# Apple App Store Server API
APPLE_BUNDLE_ID=com.alitrip.socialstory
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
MONTHLY_FREE_QUOTA=3

# Migrations: set so the server auto-applies on boot
MIGRATIONS_DIR=./migrations

# CORS
ALLOWED_ORIGINS=*
