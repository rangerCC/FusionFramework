# 测试环境配置 — copy to .env.test (do not commit real secrets)
# 与生产严格隔离：独立 DB、独立 Redis 前缀、Sandbox 内购。

APP_ENV=test
PORT=8080

# 独立的测试数据库（与生产不同实例/库名）
DATABASE_URL=postgres://ss_test:CHANGE_ME@test-pg-host:5432/socialstory_test?sslmode=require

# 可与生产共用 Redis 实例，但 key 前缀隔离（默认 ss:test:）；更稳妥用独立 DB index
REDIS_ADDR=test-redis-host:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=1
REDIS_KEY_PREFIX=ss:test:

# 测试环境独立 JWT 密钥：测试签发的 token 在生产无效，反之亦然
JWT_SECRET=CHANGE_ME_TEST_SECRET
ACCESS_TTL_SEC=7200
REFRESH_TTL_SEC=2592000

# 测试可继续用 dev 短信（固定码），或接阿里云测试签名
SMS_DEV_MODE=true
SMS_DEV_CODE=1234

# OSS：测试用独立 bucket / 路径前缀
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=socialstory-test
OSS_ACCESS_KEY=CHANGE_ME
OSS_SECRET=CHANGE_ME
OSS_PUBLIC_HOST=

# App Store：测试只认 Sandbox 交易，严格校验开启
APPLE_BUNDLE_ID=com.alitrip.socialstory
APPLE_ENVIRONMENT=Sandbox
STRICT_APPLE_ENV=true
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
MONTHLY_FREE_QUOTA=3

MIGRATIONS_DIR=./migrations
ALLOWED_ORIGINS=*
