# 生产环境配置 — copy to .env.prod (NEVER commit; perms 600)
# 与测试严格隔离：独立 DB、独立 Redis 前缀、Production 内购、强随机密钥。

APP_ENV=prod
PORT=8080

# 生产数据库（独立 RDS 实例 / 库；sslmode=require）
DATABASE_URL=postgres://ss_prod:CHANGE_ME@prod-pg-host:5432/socialstory?sslmode=require

# 生产 Redis（独立实例最佳；若共用则 key 前缀 + DB index 双隔离）
REDIS_ADDR=prod-redis-host:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_KEY_PREFIX=ss:prod:

# 生产 JWT 密钥：openssl rand -base64 48，且与测试不同
JWT_SECRET=CHANGE_ME_STRONG_RANDOM
ACCESS_TTL_SEC=7200
REFRESH_TTL_SEC=2592000

# 生产必须接真实短信
SMS_DEV_MODE=false
ALIYUN_SMS_KEY=CHANGE_ME
ALIYUN_SMS_SECRET=CHANGE_ME
SMS_SIGN_NAME=CHANGE_ME
SMS_TEMPLATE_CODE=CHANGE_ME

# OSS：生产独立 bucket
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=socialstory-prod
OSS_ACCESS_KEY=CHANGE_ME
OSS_SECRET=CHANGE_ME
OSS_PUBLIC_HOST=https://cdn.your-domain.com

# App Store：生产只认 Production 交易，严格校验开启
APPLE_BUNDLE_ID=com.alitrip.socialstory
APPLE_ENVIRONMENT=Production
STRICT_APPLE_ENV=true
APPLE_ISSUER_ID=CHANGE_ME
APPLE_KEY_ID=CHANGE_ME
APPLE_PRIVATE_KEY_PATH=/etc/socialstory/AuthKey.p8
MONTHLY_FREE_QUOTA=3

MIGRATIONS_DIR=/app/migrations
ALLOWED_ORIGINS=https://api.your-domain.com
